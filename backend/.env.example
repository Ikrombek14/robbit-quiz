# Backend konfiguratsiyasi
PORT=4000
CLIENT_URL=http://localhost:5173

# Ma'lumotlar bazasi (SQLite — dev). Postgres uchun: postgresql://user:pass@localhost:5432/robbit
DATABASE_URL="file:./dev.db"

# JWT maxfiy kaliti (ishlab chiqarishda kuchli tasodifiy qiymat qo'ying)
JWT_SECRET="dev-secret-change-me"

# Claude AI kaliti — PULLIK. Faqat CLAUDE_EMAILS dagi akkauntlar ishlatadi, qolganlar Gemini'da.
ANTHROPIC_API_KEY="sk-ant-..."
# Claude'dan foydalana oladigan akkauntlar (vergul bilan; "*" = hamma)
CLAUDE_EMAILS="ikrombekmurodov7@gmail.com"

# Google OAuth Client ID (admin Google bilan kirishi uchun)
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web)
GOOGLE_CLIENT_ID=""

# Robbit ERP (admin.robbit.uz) integratsiyasi — server-to-server, faqat o'qish.
# Kredensiallarni FAQAT shu yerga qo'ying, kodga yozmang. Bo'sh qolsa integratsiya o'chiq.
ROBBIT_ERP_URL="https://api.robbit.uz"
ROBBIT_ERP_LOGIN=""
ROBBIT_ERP_PASSWORD=""

# Google Gemini API kaliti (aistudio.google.com - TEKIN reja ishlaydi).
# AI savol generatsiyasi sukut bo'yicha shu orqali ketadi (CLAUDE_EMAILS dagilardan tashqari).
GEMINI_API_KEY=""
