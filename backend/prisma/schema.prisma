// Robbit Akademiyasi quiz platformasi — DB sxemasi
// SQLite (dev). Production'da provider'ni "postgresql" ga o'zgartirish kifoya.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Teacher {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String? // Google orqali kirganlarda bo'lmaydi
  name      String
  picture   String? // Google avatar
  isAdmin   Boolean  @default(false)
  approved  Boolean  @default(false) // roster (ustozlar ro'yxati)ga ism-familiyasi mos kelsa true
  // "Slayd qilish" ruxsati: quiz yaratish/tahrirlash + slayd generatsiya + darsga quiz biriktirish.
  // Default false — faqat admin tanlab beradi. (Host/o'yin o'tkazish hamma uchun ochiq, bunga bog'liq emas.)
  canCreate Boolean  @default(false)
  // Ofis/qabul administratori — ustoz EMAS, slayd qilmaydi. Panelga kirib faqat
  // Yo'l xaritasi va Yo'riqnomani ko'radi (ota-onalarga dasturni tanishtirish uchun).
  // Admin /users sahifasidan beradi.
  officeAdmin Boolean @default(false)
  // Admin qo'lda bergan/olib tashlagan ustoz huquqi. null = avtomatik (roster yoki admin email
  // bo'yicha). true = majburan berilgan, false = majburan olib tashlangan. approved'dan ustun.
  accessOverride Boolean?
  // Ustozlik so'rovi: roster'ga mos kelmagan foydalanuvchi "Ustozlik uchun so'rov" yuborsa
  // vaqti shu yerda turadi. Admin tasdiqlasa/rad etsa null'ga qaytadi.
  teacherRequestAt   DateTime?
  teacherRequestName String? // so'rovda ko'rsatilgan ism-familiya (jadvaldagi deb da'vo qilingani)
  // Statistika jadvalidagi (Google Sheet) ANIQ ism — admin qo'lda biriktiradi.
  // Account ismi Sheet imlosidan farq qilsa (yoki Sheet'da boshqacha yozilgan bo'lsa)
  // avtomatik moslik ishlamaydi; shu maydon to'ldirilsa statistika/tahlil aynan
  // shu nom bo'yicha olinadi va account ismiga TEGILMAYDI.
  statsName String?
  // Ustoz o'zi to'ldiradigan profil ma'lumotlari (toifa oshirish arizasi uchun ham ishlatiladi)
  phone     String?
  // Tekshirilmagan uy vazifa bloki (Sheet'da 50 tadan ko'p bo'lsa). Har kungi birinchi
  // kirish = 1 "ogohlantirish": 1 → ERP'ga yo'naltirish, 2 → ogohlantirish, 3+ → to'liq blok.
  // Raqam 50 va undan kam bo'lsa hisob 0 ga qaytadi. hwUnlockUntil — platforma admini
  // vaqtincha (12 soat) ochgan muddat.
  hwStrikes     Int       @default(0)
  hwStrikeDay   String? // oxirgi hisoblangan kun, "YYYY-MM-DD" (Toshkent vaqti)
  hwUnlockUntil DateTime?
  createdAt DateTime @default(now())
  quizzes   Quiz[]
  folders   Folder[]
  certificates      TeacherCertificate[]
  tierApplications  TierApplication[]
  oauthGrants       OAuthGrant[]
}

// Ustoz profiliga yuklagan sertifikatlar (til, texnik kurslar va h.k.) — toifa
// oshirish arizasida "hujjat" sifatida bog'lanadi.
model TeacherCertificate {
  id        String   @id @default(cuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title     String
  fileUrl   String
  createdAt DateTime @default(now())
}

// Toifa oshirish arizasi. checklist/kpiSnapshot — topshirilgan lahzadagi holatning
// JSON String sifatidagi "suratga olish"i: keyinchalik Sheet ma'lumotlari yoki
// talablar o'zgarsa ham, ariza o'sha vaqtdagi haqiqiy holatni saqlab qoladi.
model TierApplication {
  id             String    @id @default(cuid())
  teacherId      String
  teacher        Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  fromTier       Int
  toTier         Int
  note           String? // ustozning qo'shimcha izohi / havolalari
  checklist      String // JSON: [{key,label,checked}]
  certificateIds String // JSON: string[] — ariza bilan bog'langan sertifikat id'lari
  kpiSnapshot    String // JSON: TierCheck[] — topshirish vaqtidagi avtomatik ko'rsatkichlar
  // Avtomatik ko'rsatkichlardan biri bajarilmagan bo'lsa ham, ustoz "o'quv bo'limi bilan
  // maslahatlashilgan"ligini belgilab ariza topshirishi mumkin — bu holat adminga
  // panelda warning sifatida ko'rsatiladi (kpiSnapshot'dagi ok:false bandlar bilan birga).
  consultedStudyDept Boolean @default(false)
  status         String    @default("PENDING") // PENDING | INTERVIEW | APPROVED | REJECTED
  adminNote      String?
  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?
  reviewedBy     String?
}

// Kutubxona papkasi — loyihalarni guruhlash uchun. Egasiga tegishli.
// Ommaviy import qilinganda avtomatik "<ism> — <sana>" nomli papka yaratiladi.
model Folder {
  id        String   @id @default(cuid())
  name      String
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  // Ichma-ich papka: bir papka boshqa papka ichida tura oladi. parentId null → ildiz (yuqori daraja).
  parentId  String?
  parent    Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Folder[] @relation("FolderTree")
  createdAt DateTime @default(now())
  quizzes   Quiz[]

  @@index([teacherId])
  @@index([parentId])
}

// Rasmiy ustozlar ro'yxati (CSV'dan import qilinadi). Admin boshqaradi.
// Foydalanuvchi ismi-familiyasi shu yerdagi name'ga (nameKey orqali) mos kelsa
// — u "approved" bo'ladi va O'quv reja / Yo'riqnomaga kira oladi.
model RosterTeacher {
  id        String   @id @default(cuid())
  name      String // "Bobonova Gulnoza"
  branch    String? // Filial
  category  String? // Hozirgi toifasi (1/2/3)
  phone     String?
  username  String?
  status    String? // CSV status / guruh turi
  nameKey   String   @unique // normalize(name) — moslik va dedupe uchun
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Quiz {
  id          String   @id @default(cuid())
  title       String
  description String?
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  shuffle     Boolean  @default(false) // savollar tartibini aralashtirish
  folderId    String?  // kutubxona papkasi (ixtiyoriy)
  folder      Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  // Tashqi manba (Wayground/Quizizz) quiz ID — ommaviy importda takrorni aniqlash uchun.
  // Bir xil manba ID (yoki sarlavha) topilsa qayta yaratilmaydi, papkaga ko'chiriladi.
  sourceId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Har bir yozuvda (muharrir, MCP, tarixdan tiklash) +1 — bir vaqtda tahrirlash konfliktini
  // aniqlash uchun: eski versiya bilan saqlash urinishi rad etiladi (409).
  version     Int      @default(1)
  slides      Slide[]
  revisions   QuizRevision[]

  @@index([teacherId])
  @@index([createdAt])
  @@index([folderId])
  @@index([teacherId, sourceId])
}

// Universal "slayd" — ham kontent slayd, ham savol bo'lishi mumkin.
// kind: "CONTENT" | "QUESTION"
// type (faqat QUESTION uchun): SINGLE | MULTIPLE | TRUE_FALSE | DROPDOWN |
//                              POLL | OPEN | FILL_BLANK | MATCH | REORDER
// data: turga qarab JSON (matn, variantlar, javoblar, juftliklar va h.k.)
model Slide {
  id        String  @id @default(cuid())
  quizId    String
  quiz      Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order     Int     @default(0)
  kind      String  @default("QUESTION")
  type      String?
  data      String  @default("{}")
  notes     String?
  timeLimit Int     @default(20)
  points    Int     @default(1000)

  @@index([quizId, order])
}

// O'ynalgan o'yin natijasi (hisobot uchun)
model GameRecord {
  id            String             @id @default(cuid())
  teacherId     String
  quizId        String
  title         String
  pin           String
  mode          String             @default("LIVE") // LIVE | HOMEWORK
  totalSlides   Int                @default(0)
  questionStats String             @default("[]") // JSON: [{index,text,correct,total}]
  playedAt      DateTime           @default(now())
  players       GamePlayerRecord[]

  @@index([teacherId, playedAt])
  @@index([quizId])
}

model GamePlayerRecord {
  id            String     @id @default(cuid())
  gameId        String
  game          GameRecord @relation(fields: [gameId], references: [id], onDelete: Cascade)
  nickname      String
  score         Int        @default(0)
  correctCount  Int        @default(0)
  totalAnswered Int        @default(0)
  details       String     @default("[]") // TEST rejimi: har savol bo'yicha JSON [{index,text,answer,correct,timeMs,correctAns}]

  @@index([gameId])
}

// Ustozlar yo'riqnomasi: bo'limlarga ajratilgan qo'llanma
// Har bir bo'lim — sarlavha + markdown matn. Admin tahrirlaydi/o'chiradi/qo'shadi.
model GuideSection {
  id        String   @id @default(cuid())
  order     Int      @default(0)
  title     String
  body      String   @default("") // markdown matn
  icon      String?  // material symbol nomi (ixtiyoriy)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// O'quv dastur: dars rejalar
// subject: ROBOTEXNIKA | DASTURLASH
// ageGroup: JUNIOR | MIDDLE | SENIOR
// year: 1 | 2
// section: DESIGN | PROGRAMMING | ROBOTICS (faqat ROBOTEXNIKA uchun, DASTURLASH'da null)
model LessonPlan {
  id        String   @id @default(cuid())
  subject   String   // ROBOTEXNIKA | DASTURLASH
  ageGroup  String   // JUNIOR | MIDDLE | SENIOR
  year      Int      // 1 | 2
  section   String?  // DESIGN | PROGRAMMING | ROBOTICS
  order     Int      @default(0)
  title     String
  author    String?
  isDemo    Boolean  @default(false)
  quizId    String?  // biriktrilgan quiz (ixtiyoriy)
  // AI tahlili (lessonAI): slaydlardan aniqlangan modul nomi va modul ichidagi
  // taxminiy o'rin — avto-tartiblashda kalit so'zlardan kuchliroq signal.
  aiModule  String?
  aiSeq     Int?
  createdAt DateTime @default(now())
}

// Qo'shimcha darslar — O'quv dastur sahifasida alohida (uchinchi) bo'lim.
// Yosh toifasi/yo'nalish/yilga bo'linmaydi: hammasi bitta umumiy ro'yxatda
// dars nomi bilan turadi (`order` — ro'yxatdagi o'rni). Asosiy o'quv rejadan
// tashqaridagi qo'shimcha mavzular uchun.
model ExtraLesson {
  id          String   @id @default(cuid())
  order       Int      @default(0)
  title       String
  description String?  // qisqa izoh (ixtiyoriy)
  author      String?
  quizId      String?  // biriktrilgan slayd (ixtiyoriy)
  createdAt   DateTime @default(now())
}

// YANGI o'quv dastur (robbit-yangi-oquv) — oylik modullar bo'yicha darslar.
// Eski LessonPlan (JUNIOR/MIDDLE/SENIOR) tuzilmasidan farqli: bitta izchil
// 12 oylik trek (1-6 dasturlash, 7-12 robototexnika). `module` — oy/kurs nomi
// ("1-oy: Kompyuter savodxonligi + AI"), `order` — umumiy tartib.
model NewCurriculumLesson {
  id        String   @id @default(cuid())
  module    String   // oy/kurs sarlavhasi
  order     Int      @default(0)
  title     String
  author    String?
  quizId    String?  // biriktirilgan slayd (keyin qo'shiladi)
  createdAt DateTime @default(now())
}

// Ustozlik amaliyoti vazifalari — kategoriya bo'yicha guruhlangan amaliy
// topshiriqlar (Scratch, Python, Arduino...). Har vazifada bajariladigan
// topshiriq matni, video havolasi (embed) va kerakli resurslar (havolalar).
// Yangi ustozlar (amaliyotchilar) ko'radi, admin boshqaradi.
model PracticeTask {
  id        String   @id @default(cuid())
  category  String   @default("") // guruh sarlavhasi: "Scratch", "Python"...
  order     Int      @default(0)  // umumiy tartib (render'da kategoriya bo'yicha guruhlanadi)
  title     String   @default("") // qisqa nom (ixtiyoriy)
  tasks     String   @default("") // "Bajariladigan topshiriqlar" — matn (ko'p qatorli)
  videoUrl  String?  // video: embed havolasi (YouTube/Vimeo) YOKI yuklangan fayl (/uploads/..mp4)
  imageUrl  String?  // yuklangan yoki havola qilingan rasm
  resources String   @default("[]") // JSON: [{label,url}] — "Kerakli resurslar"
  createdAt DateTime @default(now())
}

// Workshoplar — o'quv dasturdan TASHQARI, bir martalik mashg'ulotlar.
// Ataylab yosh toifasi/yo'nalish/yilga bo'linmaydi: hammasi bitta umumiy
// ro'yxatda, workshop nomi bilan turadi (`order` — ro'yxatdagi o'rni).
model Workshop {
  id          String   @id @default(cuid())
  order       Int      @default(0)
  title       String
  description String?  // qisqa izoh (ixtiyoriy)
  author      String?
  quizId      String?  // biriktrilgan slayd (ixtiyoriy)
  createdAt   DateTime @default(now())
}

// Audit log — saytdagi har bir o'zgartiruvchi harakat (POST/PUT/PATCH/DELETE) kim
// tomonidan, qachon, nimaga qilingani. Roster/foydalanuvchi o'zgarishlarida "oldin → keyin"
// tafsiloti ham saqlanadi (details). Faqat qo'shiladi — tahrirlanmaydi, o'chirilmaydi.
model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorId    String? // Teacher.id (login bo'lmagan so'rovlarda null)
  actorEmail String?
  actorName  String?
  action     String // masalan "roster.update", "roster.import", "admin.user.admin" yoki "POST /api/quizzes"
  method     String
  path       String
  status     Int
  entity     String? // "RosterTeacher", "Teacher", "Quiz" ...
  entityId   String?
  summary    String? // odam o'qiydigan qisqa tavsif
  details    Json? // oldin/keyin farqlari va h.k.
  ip         String?

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action])
}

// ---- MCP / OAuth 2.1 (Claude kabi tashqi ilovalar ustoz nomidan ishlashi uchun) ----
// Barcha maxfiy qiymatlar (client secret, so'rov havolasi, code, tokenlar) bazada faqat
// SHA-256 HASH ko'rinishida saqlanadi — baza sizib chiqsa ham ulardan foydalanib bo'lmaydi.

// Ro'yxatdan o'tgan OAuth client (Dynamic Client Registration orqali, masalan claude.ai).
model OAuthClient {
  id              String       @id // client_id
  name            String?
  redirectUris    String // JSON: string[]
  metadata        Json // client metadata (secret'siz)
  secretHash      String? // confidential client bo'lsa
  secretExpiresAt Int? // unix soniya, 0/null = muddatsiz
  createdAt       DateTime     @default(now())
  grants          OAuthGrant[]
}

// /oauth/authorize'dan ruxsat sahifasigacha bo'lgan oraliq so'rov (10 daqiqa yashaydi).
model OAuthAuthRequest {
  id            String    @id // so'rov tokenining hash'i (havolada token o'zi turadi)
  clientId      String
  redirectUri   String
  codeChallenge String
  state         String?
  scopes        String // so'ralgan scope'lar, bo'sh joy bilan
  resource      String?
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([expiresAt])
}

// Ustoz bergan ruxsat (foydalanuvchi ↔ client). Bekor qilinsa barcha tokenlari ham bekor.
model OAuthGrant {
  id         String       @id @default(cuid())
  teacherId  String
  teacher    Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  clientId   String
  client     OAuthClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scopes     String // berilgan scope'lar, bo'sh joy bilan
  createdAt  DateTime     @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  revokedBy  String? // bekor qilgan Teacher.id (o'zi yoki admin)
  codes      OAuthCode[]
  tokens     OAuthToken[]

  @@index([teacherId])
  @@index([clientId])
}

// Bir martalik authorization code (5 daqiqa).
model OAuthCode {
  id            String     @id // code hash'i
  grantId       String
  grant         OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  clientId      String
  redirectUri   String
  codeChallenge String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime   @default(now())

  @@index([grantId])
}

// Access (1 soat) va refresh (30 kun) tokenlar. family — refresh rotation zanjiri:
// ishlatilgan refresh qayta kelsa (o'g'irlangan bo'lishi mumkin) butun zanjir bekor qilinadi.
model OAuthToken {
  id        String     @id @default(cuid())
  tokenHash String     @unique
  kind      String // ACCESS | REFRESH
  grantId   String
  grant     OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  family    String
  expiresAt DateTime
  usedAt    DateTime? // REFRESH: almashtirilgan (rotation) vaqti
  revokedAt DateTime?
  createdAt DateTime   @default(now())

  @@index([grantId])
  @@index([family])
  @@index([expiresAt])
}

// Quiz versiyalar tarixi: har bir yozuvdan OLDINGI to'liq holat (oxirgi 20 tasi saqlanadi).
// Soft delete o'rniga — o'chirilgan slayd ham shu yerdan tiklanadi.
model QuizRevision {
  id        String   @id @default(cuid())
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  version   Int // shu holat qaysi versiya edi
  snapshot  Json // { title, description, shuffle, slides: [{kind,type,data,notes,timeLimit,points}] }
  source    String // editor | mcp | restore
  actorId   String?
  actorName String?
  summary   String?
  createdAt DateTime @default(now())

  @@index([quizId, createdAt])
}

// MCP orqali taklif qilingan, foydalanuvchi tasdig'ini kutayotgan yozuvchi amal.
// actionId'ning o'zi saqlanmaydi (hash). Parametrlar serverda — tasdiqda o'zgartirib bo'lmaydi.
model McpPendingAction {
  id          String    @id @default(cuid())
  actionHash  String    @unique
  teacherId   String
  grantId     String
  clientId    String
  tool        String // create_quiz | add_slide | update_slide
  params      Json
  quizId      String?
  quizVersion Int? // taklif paytidagi versiya — tasdiqda solishtiriladi
  summary     String
  preview     String // foydalanuvchiga ko'rsatilgan o'zbekcha matn
  status      String    @default("PENDING") // PENDING | EXECUTED | CANCELLED | EXPIRED | FAILED
  result      Json?
  expiresAt   DateTime
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([teacherId, status])
  @@index([expiresAt])
}
